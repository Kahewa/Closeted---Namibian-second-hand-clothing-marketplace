rules_version = '2';

// Deploy with `firebase deploy --only storage` or paste into
// Firebase Console → Storage → Rules.
service firebase.storage {
  match /b/{bucket}/o {

    // Profile pictures — one per user, 5MB cap, images only.
    match /profile-pics/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Carousel item photos — 8MB cap per photo, images only.
    match /carousels/{uid}/{carouselId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
