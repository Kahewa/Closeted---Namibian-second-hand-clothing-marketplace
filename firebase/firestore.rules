rules_version = '2';

// Deploy with `firebase deploy --only firestore:rules` or paste into
// Firebase Console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // The one admin account — the only login on the site, opened by the
    // admin password. The uid comes from the verified auth token, so it
    // can't be spoofed by a client. Set by `npm run admin:password`;
    // mirrored in public/js/utils.js (ADMIN_UID).
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'aNHz1YdC6De9S7aS0GZqBUlBlp73';
    }

    // ---------------------------------------------------------------
    // items/{itemId} — one posted piece: up to 5 photos (images, with the
    // cover mirrored in imageURL), category, size, brand, condition, price,
    // notes, WhatsApp number, sold, and clientId (who it's sold for).
    // Anyone can browse; only the admin can post, edit or delete.
    // ---------------------------------------------------------------
    match /items/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.category in
             ['Shirt', 'Top', 'Belt', 'Pants', 'Skirt', 'Shorts', 'Dress', 'Shoes', 'Heels', 'Accessories']
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && (!('images' in request.resource.data)
            || (request.resource.data.images is list && request.resource.data.images.size() <= 5));
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // clients/{clientId} — the people whose pieces the admin sells for
    // them: { name, createdAt }. Private: only the admin sees the names;
    // items carry just the opaque clientId.
    // ---------------------------------------------------------------
    match /clients/{clientId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
    }

    // Everything else (the old users / usernames / carousels collections
    // included) is closed. Firestore denies anything not matched above.
  }
}
