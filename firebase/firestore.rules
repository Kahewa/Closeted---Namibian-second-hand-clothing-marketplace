rules_version = '2';

// Deploy with `firebase deploy --only firestore:rules` or paste into
// Firebase Console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The one admin account. Email comes from the verified auth token, so
    // this can't be spoofed by a client.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'bygreys.na@gmail.com';
    }

    // `.get(field, default)` rather than `.field`: reading a key that isn't
    // on the document raises an error and fails the whole rule, which would
    // lock out every account created before `banned` was added.
    function notBanned() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
      );
    }

    // ---------------------------------------------------------------
    // invites/{code} — the platform is invite-only.
    //
    // Anyone can read a single invite by its code, because the sign-up
    // page has to check the link it was given. Nobody but the admin can
    // list them, so codes can't be harvested by guessing at the
    // collection. A signed-in user may stamp exactly one unused invite
    // with their own uid, and nothing else.
    // ---------------------------------------------------------------
    match /invites/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.get('usedBy', null) == null
            && resource.data.get('revoked', false) != true
            && request.resource.data.usedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt']));
    }

    // ---------------------------------------------------------------
    // users/{uid} — public profile: username, pic, bio, social links.
    //
    // Creating a profile is what actually makes someone a member, so this
    // is where the invite is enforced. `getAfter` reads the invite as it
    // will be once the batch commits, so the profile and the claim on the
    // invite have to land together or not at all.
    // ---------------------------------------------------------------
    function claimedAnInvite(uid) {
      return request.resource.data.get('inviteCode', '') != ''
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.get('usedBy', '') == uid;
    }

    match /users/{uid} {
      allow read: if true;                 // profiles + username search are public
      allow create: if isOwner(uid) && (isAdmin() || claimedAnInvite(uid));
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------------------------------------------------------------
    // usernames/{username} — one doc per taken username, holding the uid
    // that owns it. Firestore has no unique-column constraint; this is
    // the standard substitute. `create` fails automatically if the doc
    // already exists, which is what makes the name unique.
    // ---------------------------------------------------------------
    match /usernames/{name} {
      allow read: if true;                 // so signup can check availability
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;              // release and re-claim instead
    }

    // A WhatsApp number is how buyers make contact, not evidence of who
    // anyone is, so posting a closet needs somewhere buyers can actually
    // look the seller up. Defaulted reads throughout: a profile written
    // before socialLinks existed must fail this check, not error on it.
    function socialLinks() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('socialLinks', {});
    }

    // `is string` before trim(): an old profile could hold a null here, and
    // calling trim() on it would raise rather than simply fail the check.
    function filledIn(links, key) {
      return links.get(key, '') is string && links.get(key, '').trim() != '';
    }

    function hasSocialProof() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          filledIn(socialLinks(), 'instagram')
          || filledIn(socialLinks(), 'tiktok')
          || filledIn(socialLinks(), 'facebook')
        );
    }

    // ---------------------------------------------------------------
    // carousels/{carouselId} — a seller's closet drop.
    // The N$150 fee is paid manually (bank transfer / wallet), so a new
    // carousel lands as 'pending' and only the admin can move it to
    // 'approved'. The feed reads approved ones; a seller sees their own
    // pending ones on their profile with a "waiting for approval" note.
    // ---------------------------------------------------------------
    match /carousels/{carouselId} {
      allow read: if true;                 // the feed is public

      allow create: if isSignedIn()
        && notBanned()
        && (isAdmin() || hasSocialProof())
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.keys().hasAll(['sellerId', 'items', 'createdAt', 'status'])
        // admin posts go live immediately; everyone else waits for approval
        && (isAdmin()
              ? request.resource.data.status == 'approved'
              : request.resource.data.status == 'pending');

      // Sellers can edit their own listing (mark items sold) but must not
      // change `status` — that's what would let them approve themselves.
      // Defaulted reads again, so carousels posted before `status` existed
      // stay editable by their owner instead of erroring.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.sellerId == request.auth.uid
            && request.resource.data.get('status', '') == resource.data.get('status', ''));

      allow delete: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
    }
  }
}
