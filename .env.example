# Copy this file to .env and fill in the real values.
# NEVER put real credentials in this file — it IS committed to git.
PORT=3000

# Cloudinary — used only to DELETE images when a seller removes a carousel.
# Uploading happens in the browser with the unsigned preset in
# public/js/cloudinary.js and needs none of these.
# Dashboard → the cloud name at the top, then Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Deployed on Vercel? Set these four in Vercel - Settings - Environment
# Variables, not here. api/media/delete.js reads them to remove a listing's
# photos from Cloudinary when it is deleted.
#   CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
#   FIREBASE_PROJECT_ID=closet-bg
